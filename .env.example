# KitsuneDen environment (optional)
#
# You don't need this file. On first run the Den asks for a password in the
# browser (guarded by a setup code printed to the server log) and keeps an
# scrypt hash of it, plus a generated session secret, in data/den-auth.json.
#
# Set these only if you'd rather manage auth here. Values in this file win
# over the ones from first-run setup, and the Settings page will tell you to
# change the password here instead.

# Shared password for the dashboard. Everyone you let into the Den knows it.
# KITSUNEDEN_PASSWORD="pick-a-memorable-phrase"

# HMAC key for signing session cookies, 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it signs everyone out, which is what you want when a password leaks.
# KITSUNEDEN_SESSION_SECRET="put-32-or-more-random-bytes-here-and-keep-it-secret"

# Where the Den keeps its runtime files (activity log, password hash, session
# secret, setup code). Defaults to ./data.
# KITSUNEDEN_DATA_DIR="C:\\KitsuneDen\\data"
