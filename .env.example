# KitsuneDen environment

# REQUIRED — shared password for the dashboard.
# Everyone you let into the Den knows this one. Rotating means telling
# everyone, so pick a memorable phrase and write it down somewhere
# trusted (1Password, Bitwarden, sticky note inside your monitor stand).
KITSUNEDEN_PASSWORD="change-me-before-you-deploy"

# REQUIRED — HMAC key for signing session cookies. 32+ random chars.
# Generating one:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this invalidates every active session (forces a re-login),
# which is what you want when a password leaks.
KITSUNEDEN_SESSION_SECRET="put-32-or-more-random-bytes-here-and-keep-it-secret"
